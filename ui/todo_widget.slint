import { Theme } from "theme.slint";
import { DragHandle } from "components/drag_handle.slint";
import { TodoItem } from "components/todo_item.slint";
import { ScrollView } from "std-widgets.slint";
import { Button } from "components/button.slint";
import { CustomLineEdit } from "components/line_edit.slint";

export component TodoWidget inherits Window {
    width: 320px;
    height: 400px;
    no-frame: true;
    background: transparent;
    always-on-top: true;
    default-font-family: "Microsoft YaHei UI";

    Rectangle {
        border-radius: 8px;
        background: Theme.sticky-background;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: Theme.spacing-small;
            spacing: Theme.spacing-small;
            
            DragHandle {
                title: "Todo List";
            }

            ScrollView {
                VerticalLayout {
                    spacing: 4px;
                    padding-bottom: Theme.spacing-small;
                    
                    TodoItem { text: "Review Architecture Design"; checked: true; }
                    TodoItem { text: "Implement Slint Components"; checked: true; }
                    TodoItem { text: "Add winit raw window handle"; checked: false; }
                    TodoItem { text: "Write Walkthrough Document"; checked: false; }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing-small;
                height: 36px;
                
                input := CustomLineEdit {
                    placeholder-text: "Add new task...";
                }
                
                Button {
                    text: "Add";
                    width: 60px;
                    ghost: true;
                }
            }
        }
    }
}
