import { Theme } from "../theme.slint";

export component TodoItem inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;

    height: 32px;
    background: hover.has-hover ? Theme.surface.brighter(0.5) : transparent;
    border-radius: 4px;

    Rectangle {
        x: Theme.spacing-small;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.checked ? Theme.primary : Theme.text-secondary;
        background: root.checked ? Theme.primary.transparentize(0.8) : transparent;

        Text {
            text: "v";
            color: Theme.primary;
            font-size: 11px;
            font-weight: 700;
            visible: root.checked;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    Text {
        x: Theme.spacing-small + 16px + Theme.spacing-small;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: root.checked ? Theme.text-secondary : Theme.text;
        font-size: Theme.font-size-regular;
    }

    hover := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.checked = !root.checked; }
    }
}
