// 设计系统主题变量 — 与 design.pen 变量保持一致
export global Theme {
    // ── 核心颜色 ──────────────────────────────────────
    // --abyss-black: 最深背景
    out property <color> background: #050507;
    // --carbon-surface: 卡片/面板背景
    out property <color> surface: #101010;
    // --emerald-signal: 主色（激活、Logo、高亮边框）
    out property <color> primary: #00d992;
    // --volt-mint: 次色（主要按钮文字、激活动作）
    out property <color> volt-mint: #2fd6a1;
    // --warm-charcoal: 普通边框/分隔线
    out property <color> border: #3d3a39;
    // --snow-white: 主要文字
    out property <color> text: #f2f2f2;
    // --warm-parchment: 次要文字
    out property <color> text-secondary: #b8b3b0;
    // --steel-slate: 禁用/辅助文字、未选中图标
    out property <color> text-muted: #8b949e;

    // ── Sticky / Todo 小部件专用 ───────────────────────
    out property <color> sticky-background: #151515ee;
    out property <color> sticky-text: #e0e0e0;

    // ── 排版 ─────────────────────────────────────────
    out property <length> font-size-small: 12px;
    out property <length> font-size-regular: 14px;
    out property <length> font-size-medium: 16px;
    out property <length> font-size-large: 18px;
    out property <length> font-size-title: 24px;
    out property <length> font-size-headline: 36px;

    // ── 间距 ─────────────────────────────────────────
    // --spacing-sm = 8
    out property <length> spacing-small: 8px;
    // --spacing-md = 16
    out property <length> spacing-regular: 16px;
    // --spacing-lg = 24
    out property <length> spacing-large: 24px;

    // ── 圆角 ─────────────────────────────────────────
    // --radius-sm = 4
    out property <length> radius-small: 4px;
    // --radius-md = 6
    out property <length> radius-medium: 6px;
    // --radius-lg = 8
    out property <length> radius-large: 8px;
}
