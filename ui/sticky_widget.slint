import { Theme } from "theme.slint";
import { DragHandle } from "components/drag_handle.slint";
import { TextEdit } from "std-widgets.slint";

export component StickyWidget inherits Window {
    width: 320px;
    height: 360px;
    no-frame: true;
    background: transparent;
    always-on-top: true;

    Rectangle {
        border-radius: 8px;
        background: Theme.sticky-background;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: Theme.spacing-small;
            
            DragHandle {
                title: "Sticky Note";
            }

            Rectangle {
                background: transparent;
                TextEdit {
                    text: "Welcome to Widget RS!\n\nThis is a floating sticky note.\nIt uses a dark translucent background with emerald accents.";
                    font-size: Theme.font-size-regular;
                }
            }
        }
    }
}
