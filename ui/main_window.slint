// 主窗口 — 对应 design.pen main-window (1200×800)
// 布局：左侧边栏(280px) + 右侧内容区
// 侧边栏：Logo区 → 导航菜单 → 弹性空间 → 系统状态
// 内容区：页面标题行 → 已安装小部件卡片网格(2×2)
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "components/button.slint";
import { Card } from "components/card.slint";

// 小部件状态徽章：运行中 or 已停止
component StatusBadge inherits Rectangle {
    in property <bool> running: true;
    height: 22px;
    border-radius: 4px;
    background: root.running ? #00d9921a : Theme.surface;
    border-width: 1px;
    border-color: root.running ? Theme.primary : Theme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.running ? "● 运行中" : "● 已停止";
            color: root.running ? Theme.primary : Theme.text-muted;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Removed inline buttons, using shared Button component from components/button.slint

// 小部件卡片行（标题+状态徽章）
component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> running: true;
    alignment: space-between;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    StatusBadge { running: root.running; }
}

// 卡片操作行（设置 + 主要操作）
component CardActions inherits HorizontalLayout {
    in property <string> primary-label: "显示/隐藏";
    alignment: end;
    spacing: 8px;

    Button {
        text: "设置";
        variant: ButtonVariant.Secondary;
        height: 32px;
        font-size: 13px;
    }
    Button {
        text: root.primary-label;
        variant: ButtonVariant.Primary;
        height: 32px;
        font-size: 13px;
    }
}

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: Theme.background;
    title: "Widget RS — Control Center";
    // 指定支持中文的字体，解决默认字体不含 CJK 字形导致的乱码
    // 微软雅黑 UI 是 Windows 上最清晰的中文屏幕字体
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;


    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ══════════════════════════════════════════════
        // 左侧边栏 (280px) — carbon-surface 背景
        // ══════════════════════════════════════════════
        Rectangle {
            width: 280px;
            background: Theme.surface;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // ── Logo 区 ──────────────────────────
                HorizontalLayout {
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 16px;
                    alignment: start;

                    // Logo 图标
                    Image {
                        source: @image-url("../logos/icon.png");
                        width: 40px;
                        height: 40px;
                        image-fit: contain;
                    }

                    // 应用名称
                    Text {
                        text: "Widget RS";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // ── 导航菜单区 ───────────────────────
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    // 导航项 1：控制面板（激活态）
                    Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: #00d9921a;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00d99233;
                        drop-shadow-offset-y: 0px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: "●";
                                color: Theme.primary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "控制面板";
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 导航项 2：小部件库（未选中）
                    Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: nav2-ta.has-hover ? Theme.surface.brighter(1.2) : transparent;
                        nav2-ta := TouchArea {}
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: "○";
                                color: Theme.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "小部件库";
                                color: Theme.text-secondary;
                                font-size: 15px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 导航项 3：设置（未选中）
                    Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: nav3-ta.has-hover ? Theme.surface.brighter(1.2) : transparent;
                        nav3-ta := TouchArea {}
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: "○";
                                color: Theme.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "设置";
                                color: Theme.text-secondary;
                                font-size: 15px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 弹性占位
                Rectangle { vertical-stretch: 1; }

                // ── 底部状态区 ───────────────────────
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: Theme.background;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: start;

                            // 绿色状态指示点
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.primary;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "系统运行中";
                                color: Theme.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 竖向分隔线
        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // ══════════════════════════════════════════════
        // 右侧主内容区
        // ══════════════════════════════════════════════
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 24px;
            spacing: 16px;

            // ── 页面标题行 ───────────────────────────
            HorizontalLayout {
                alignment: space-between;
                height: 60px;

                // 左侧：大标题 + 副标题
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "控制面板";
                        color: Theme.text;
                        font-size: 36px;
                        font-weight: 400;
                        letter-spacing: -0.9px;
                    }
                    Text {
                        text: "管理您的桌面小部件";
                        color: Theme.text-secondary;
                        font-size: 16px;
                    }
                }

                // 右侧：添加小部件按钮
                HorizontalLayout {
                    alignment: end;

                    Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.primary;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #2fd6a133;
                        drop-shadow-offset-y: 0px;
                        add-btn-ta := TouchArea {}
                        animate opacity { duration: 100ms; }
                        opacity: add-btn-ta.pressed ? 0.7 : 1.0;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: "+";
                                color: Theme.volt-mint;
                                font-size: 18px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "添加小部件";
                                color: Theme.volt-mint;
                                font-size: 16px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── 区块标题行 ───────────────────────────
            HorizontalLayout {
                alignment: space-between;
                height: 24px;

                Text {
                    text: "已安装的小部件";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                    letter-spacing: 0.45px;
                    vertical-alignment: center;
                }
                Text {
                    text: "4 个小部件";
                    color: Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            // ── 小部件卡片网格 (2×2) ─────────────────
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                // 第一行：便签 + 待办事项
                HorizontalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    // 便签卡片（高亮 — 运行中）
                    Card {
                        glowing: true;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            CardHeader { title: "便签"; running: true; }

                            // 便签内容预览
                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 4px;
                                background: #fff2c5;
                                border-width: 1px;
                                border-color: #e5d8af;
                                clip: true;

                                Text {
                                    x: 12px;
                                    y: 12px;
                                    text: "这是一个便签示例...";
                                    color: #4a4531;
                                    font-size: 13px;
                                }
                            }

                            CardActions { primary-label: "显示/隐藏"; }
                        }
                    }

                    // 待办事项卡片（高亮 — 运行中）
                    Card {
                        glowing: true;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            CardHeader { title: "待办事项"; running: true; }

                            // 待办列表预览
                            VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 8px;
                                alignment: start;

                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: #141414;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        alignment: start;
                                        Text {
                                            text: "○";
                                            color: Theme.primary;
                                            font-size: 14px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "完成项目设计";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: #141414;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        alignment: start;
                                        Text {
                                            text: "●";
                                            color: Theme.primary;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "编写文档";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            CardActions { primary-label: "显示/隐藏"; }
                        }
                    }
                }

                // 第二行：时钟 + 系统监控
                HorizontalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    // 时钟卡片（基础 — 已停止）
                    Card {
                        glowing: false;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            CardHeader { title: "时钟"; running: false; }

                            // 时钟显示
                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 4px;
                                background: Theme.background;

                                Text {
                                    text: "-- : --";
                                    color: Theme.text-secondary;
                                    font-size: 32px;
                                    font-weight: 300;
                                    letter-spacing: 2px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            CardActions { primary-label: "启动"; }
                        }
                    }

                    // 系统监控卡片（基础 — 已停止）
                    Card {
                        glowing: false;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            CardHeader { title: "系统监控"; running: false; }

                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 4px;
                                background: Theme.background;

                                Text {
                                    text: "点击启动以显示系统信息";
                                    color: Theme.text-muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            CardActions { primary-label: "启动"; }
                        }
                    }
                }
            }
        }
    }
}
